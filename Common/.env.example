# .env -- Shared local-LLM pipeline configuration.
# Copy to Common/.env (gitignored) and edit. Real shell env vars take
# precedence over values here.
#
# Consumed by the Python orchestrator (Common/_pipeline/) and the PowerShell
# workers (LocalLLMAnalysis/, LocalLLMDebug/) via Common/llm_core.ps1.

# == Backend ==============================================================
# vllm   -> talk to the LLMConfig OpenAI /v1 gateway (default). The gateway
#           auto-loads the requested model onto the GPU on first request.
# ollama -> talk to a raw Ollama server's native /api/chat (num_ctx + think).
LLM_BACKEND=vllm

# == Endpoint ============================================================
# Host of the LLMConfig box (gateway + Ollama live on the same machine).
# vllm   -> http://<LLM_HOST>:11430   (the gateway; LLM_PORT is ignored)
# ollama -> http://<LLM_HOST>:<LLM_PORT or 11434>
# Set LLM_ENDPOINT to a full URL to override either (e.g. a non-standard port).
LLM_HOST=192.168.1.126
LLM_PORT=11434
#LLM_ENDPOINT=http://192.168.1.126:11430

# == Models ==============================================================
# IMPORTANT: id format is backend-specific and the gateway routes by it.
#   vllm   -> vLLM served-names, which use '-'  (qwen3-coder-30b, qwen3.5-27b)
#   ollama -> Ollama tags,       which use ':'  (qwen3-coder:30b, gemma4:26b)
# A ':' id sent to the gateway is routed to Ollama even on the vllm backend,
# so keep these in the format that matches LLM_BACKEND.
#
# Resolution chain (Python cfg.resolve_model and PowerShell Get-LLMModel):
#   role-specific key -> LLM_DEFAULT_MODEL -> hardcoded fallback.
LLM_DEFAULT_MODEL=qwen3-coder-30b

# Planning stages (coding 0/1). A higher-context alias helps long plans;
# qwen3.5-27b serves at 65536. Leave blank to use LLM_DEFAULT_MODEL.
LLM_PLANNING_MODEL=qwen3.5-27b

# Coder stages (coding 2a/2b/3a/3b), aider (stage 4), fix_imports (stage 5),
# and the analysis/debug workers fall back to this when their role key is
# blank. Leave blank to use LLM_DEFAULT_MODEL.
#LLM_AIDER_MODEL=
#LLM_MODEL=

# == Thinking (ollama backend only) ======================================
# The vLLM aliases set no reasoning-parser, so think/thinking-sidecars are
# inert on the vllm backend; these apply only when LLM_BACKEND=ollama.
LLM_THINK=true
LLM_SAVE_THINKING=true

# == Context / token / timeout budgets ===================================
# num_ctx applies to the ollama backend only; on vllm the context window is
# fixed per alias at serve time (e.g. 65536). Keep max-token budgets under
# the alias ceiling on vllm.
LLM_PLANNING_NUM_CTX=65536
LLM_PLANNING_MAX_TOKENS=16384
LLM_PLANNING_TIMEOUT=1200

LLM_AIDER_NUM_CTX=40960
LLM_NUM_CTX=32768
LLM_ANALYSIS_NUM_CTX=49152

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT=900

# bughunt_iterative analyse/fix budgets (must fit reasoning + output).
BUGHUNT_ANALYSE_TOKENS=8000
BUGHUNT_FIX_TOKENS=16000

# == Debug <- Analysis integration paths =================================
# When the analysis pipeline has run, debug workers consume its outputs.
# Leave empty to disable. Relative to the repo root unless absolute.
ARCHITECTURE_DIR=architecture
SERENA_CONTEXT_DIR=architecture/.serena_context

# == Target codebase =====================================================
PRESET=python
CODEBASE_DESC="One-line description of the target project and its stack."

# == File handling =======================================================
MAX_FILE_LINES=800
SKIP_TRIVIAL=1
MIN_TRIVIAL_LINES=10
CHUNK_THRESHOLD=400

# Match source + project config; exclude generated/cache dirs.
INCLUDE_EXT_REGEX=\.(py|toml)$
EXCLUDE_DIRS_REGEX=[/\\](\.git|architecture|__pycache__|\.egg-info|\.tox|\.venv|venv|dist|build|\.pytest_cache|\.mypy_cache)([/\\]|$)

# == Subsections (analysis mode iterates these) ==========================
#Subsections begin
src/yourpackage
#Subsections end
